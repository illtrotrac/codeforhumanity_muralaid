# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored: real secrets must never be committed.

# Password for the seeded demo admin accounts (one per organisation, plus
# presenter@muralaid.test, who can manage every mural). Pick anything long.
# Accounts are only created when this is set.
MURALAID_ADMIN_PASSWORD=

# Stripe TEST mode secret key (starts with sk_test_). Leave empty to use
# demo pledges with no payment step.
STRIPE_SECRET_KEY=

# Only needed if you forward Stripe webhooks locally with the Stripe CLI.
STRIPE_WEBHOOK_SECRET=
